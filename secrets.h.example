#pragma once
// =============================================================
//  RJL Live Gate - secrets TEMPLATE.  Safe to commit.
//  Copy this file to  secrets.h  (same folder), fill in real
//  values. secrets.h is gitignored and never leaves the bench.
// =============================================================

// ---- Per-UNIT identity (unique to every gate) ----
#define SECRET_GATE_ID      "your-gate-id"             // e.g. acme-0001
#define SECRET_HMAC_SECRET  "32_char_hex_signing_key"  // must match this gate's gate_secrets row

// ---- On-site tap-page PIN ----
#define SECRET_LOCAL_PIN    "0000"

// ---- HiveMQ broker login ----
#define SECRET_MQTT_USER    "your-hivemq-user"
#define SECRET_MQTT_PASS    "your-hivemq-pass"

// ---- Site WiFi (delete both if using the captive-portal provisioner) ----
#define SECRET_WIFI_SSID    "site-wifi-ssid"
#define SECRET_WIFI_PASS    "site-wifi-pass"
